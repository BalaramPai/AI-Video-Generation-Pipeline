OPENAI_API_KEY=
OLLAMA_MODEL=llama3.1:8b

# Generate video through Runway. Switch RUNWAY_MODEL to choose the model.
VIDEO_PROVIDER=runway
RUNWAYML_API_SECRET=
RUNWAY_MODEL=gen4.5
RUNWAY_POLL_INTERVAL_SECONDS=5
RUNWAY_TIMEOUT_SECONDS=900

# Set RUNWAY_MODEL=grok_imagine_1_5 to use Grok Imagine Video 1.5 on Runway.

# Optional Google Veo provider:
# VIDEO_PROVIDER=veo
# GEMINI_API_KEY=
# VEO_MODEL=veo-3.1-generate-preview
# VEO_POLL_INTERVAL_SECONDS=5
# VEO_TIMEOUT_SECONDS=900

# Use VIDEO_PROVIDER=ffmpeg only as a local still-image fallback.
# Set FFMPEG_PATH if ffmpeg is not available on PATH.
